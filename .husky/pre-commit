#!/bin/bash

# =========================================================================
# 【修改顺序铁律】唯一协议与代码同步审计
# =========================================================================
# husky 9 的 .husky/_/h 用 `sh -e` 执行本脚本：任何非 0 语句都会立即终止整个 hook。
# `VAR=$(... | grep ...)` 的退出码等于 grep 的退出码，而 grep 无匹配返回 1，
# 因此纯文档提交（或任何未同时包含代码与 agreement 的提交）会在下面两行被静默拦下，
# 连 cargo make pre-commit 与第 9~21 行的「修改顺序铁律」提示都不会执行。
# `|| true` 让赋值恒成功，把「有没有匹配」交还给下面的 if 判断（BUG-374）。
STAGED_CODE_FILES=$(git diff --cached --name-only | grep -E '\.(ts|tsx|rs)$|tauri\.conf\.json$' || true)
STAGED_AGREEMENTS_FILE=$(git diff --cached --name-only | grep -E '^clash_mini_agreements\.md$' || true)

if [ -n "$STAGED_CODE_FILES" ] && [ -z "$STAGED_AGREEMENTS_FILE" ]; then
  echo "========================================================================="
  echo "❌ 阻止提交 (Commit Blocked): 【修改顺序铁律】"
  echo "检测到您修改了代码或配置文件，但未在《唯一协议》中记录对应的修改规范！"
  echo "修改的代码文件包括:"
  echo "$STAGED_CODE_FILES"
  echo ""
  echo "👉 解决方法: 请首先在 clash_mini_agreements.md 中记录您的设计与逻辑修改，"
  echo "   然后使用 'git add clash_mini_agreements.md' 暂存该文件，再尝试提交。"
  echo "👉 (如果确实是纯格式化或微小排版且不改变逻辑的提交，可以使用 git commit --no-verify 绕过此限制)"
  echo "========================================================================="
  exit 1
fi

if ! command -v "cargo-make" >/dev/null 2>&1; then
  echo "❌ cargo-make is required for pre-commit checks."
  cargo install --force cargo-make
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "❌ pnpm is required for pre-commit checks."
  exit 1
fi

cargo make pre-commit
